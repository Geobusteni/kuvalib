generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
  GUEST
}

enum AccessType {
  PASSWORD
  EMAIL
}

enum FeedbackType {
  LIKE
  DISLIKE
  COMMENT
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  password  String?
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ProjectAssignment[]
}

model Project {
  id         String     @id @default(cuid())
  title      String
  eventDate  DateTime?
  accessType AccessType @default(PASSWORD)

  /// AES-256-GCM ciphertext, not a hash — the photographer must be able to read
  /// the password back to share it with a client.
  password String?

  /// The client-facing ZIP is uploaded by the admin, never generated from the
  /// photos. No archive means no "Download ZIP" button.
  archiveName String?
  archiveSize Int?

  expiresAt  DateTime?
  zipEnabled Boolean   @default(true)
  dlEnabled  Boolean   @default(true)

  /// Client culling: like/dislike/comment on individual photos. Off by default —
  /// the photographer opts a project in explicitly, same as zipEnabled/dlEnabled.
  feedbackEnabled Boolean @default(false)

  /// Bumped whenever the admin resets a project's feedback. Sent to the client
  /// alongside feedbackEnabled; the browser compares it against the reset epoch
  /// recorded in its own localStorage cache and discards that cache on mismatch.
  /// This is what actually re-unlocks the buttons for a visitor whose browser
  /// still thinks it already reacted — nothing server-side can reach into
  /// another origin's localStorage to clear it directly.
  feedbackResetAt DateTime @default(now())

  dlCount    Int       @default(0)
  visitCount Int       @default(0)
  lastAccess DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  photos      Photo[]
  assignments ProjectAssignment[]
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Photo {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Generated UUID used on disk — keeps the filesystem free of traversal and
  /// encoding hazards.
  filename String

  /// The name the photographer uploaded. Used for downloads and ZIP entries.
  originalName String

  width     Int
  height    Int
  size      Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([projectId, originalName])

  feedback PhotoFeedback[]
}

/// One row per (photo, visitor) action. There are no gallery-visitor accounts —
/// visitorId is a random id the browser generates once and keeps in
/// localStorage, reused across every project it visits. A photo accumulates
/// many independent rows, not one verdict; admin sees these as aggregated
/// counts plus the raw comment text. Never treat visitorId as PII.
model PhotoFeedback {
  id      String @id @default(cuid())
  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  visitorId String
  type      FeedbackType

  /// Only present when type == COMMENT. @db.Text because Prisma's default
  /// String maps to VARCHAR(191) on MySQL, too short for free text.
  comment String? @db.Text

  createdAt DateTime @default(now())

  /// The server-side half of "first choice is final": a second POST for the
  /// same (photo, visitor) is rejected with 409, regardless of what the
  /// client's own localStorage claims.
  @@unique([photoId, visitorId])
}
