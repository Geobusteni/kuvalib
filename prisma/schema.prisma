generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
  GUEST
}

enum AccessType {
  PASSWORD
  EMAIL
}

enum FeedbackType {
  LIKE
  DISLIKE
  COMMENT
}

/// Drives the showcase accent hue. Purely presentational — the gallery has no
/// notion of an event type.
enum ShowcaseEventType {
  WEDDING
  BIRTHDAY
  CHRISTENING
  CORPORATE
  GENERIC
}

enum ShowcaseBg {
  NEUTRAL
  DEEP
  ACCENT
}

enum ShowcaseAnimation {
  TURN
  FADE
  ZOOM
  ROTATE
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String?  @unique
  password  String?
  name      String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments ProjectAssignment[]
}

model Project {
  id         String     @id @default(cuid())
  title      String
  eventDate  DateTime?
  accessType AccessType @default(PASSWORD)

  /// AES-256-GCM ciphertext, not a hash — the photographer must be able to read
  /// the password back to share it with a client.
  password String?

  /// The client-facing ZIP is uploaded by the admin, never generated from the
  /// photos. No archive means no "Download ZIP" button.
  archiveName String?
  archiveSize Int?

  expiresAt  DateTime?
  zipEnabled Boolean   @default(true)
  dlEnabled  Boolean   @default(true)

  /// Client culling: like/dislike/comment on individual photos. Off by default —
  /// the photographer opts a project in explicitly, same as zipEnabled/dlEnabled.
  feedbackEnabled Boolean @default(false)

  /// Bumped whenever the admin resets a project's feedback. Sent to the client
  /// alongside feedbackEnabled; the browser compares it against the reset epoch
  /// recorded in its own localStorage cache and discards that cache on mismatch.
  /// This is what actually re-unlocks the buttons for a visitor whose browser
  /// still thinks it already reacted — nothing server-side can reach into
  /// another origin's localStorage to clear it directly.
  feedbackResetAt DateTime @default(now())

  dlCount    Int       @default(0)
  visitCount Int       @default(0)
  lastAccess DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  photos      Photo[]
  assignments ProjectAssignment[]

  /// A project has at most one showcase — a designed, page-by-page slideshow
  /// built from the same photos and shared on its own link. It inherits this
  /// project's accessType, password and expiresAt; there is no separate gate.
  showcase Showcase?
}

/// Stage 2: the client-facing designed slideshow. One per project. Photos are
/// referenced by existing Photo.id — never duplicated. Access is the project's:
/// passing the showcase gate sets the same kuvalib_gallery_[projectId] cookie the
/// gallery checks, so a client moves between the two without re-entering the
/// password.
model Showcase {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title     String
  eventDate DateTime?

  eventType      ShowcaseEventType @default(GENERIC)
  albumBg        ShowcaseBg        @default(NEUTRAL)
  animationStyle ShowcaseAnimation @default(TURN)

  autoplay        Boolean @default(true)
  autoplaySeconds Int     @default(5)
  playlistLoop    Boolean @default(true)

  /// Default px size per heading level (h1–h6), overridable per Headline block.
  /// {h1,h2,h3,h4,h5,h6: number}; see HEADING_SIZE_DEFAULTS in showcase-blocks.ts.
  headingSizes Json?
  /// Default px size per Text block preset (small/normal/medium/large/huge),
  /// overridable per block. See TEXT_SIZE_DEFAULTS in showcase-blocks.ts.
  textSizes Json?

  /// The admin's own palette — an array of hex strings offered as quick-pick
  /// swatches everywhere a custom colour is chosen in the builder. Null falls
  /// back to DEFAULT_COLOR_PRESETS in showcase-blocks.ts. Builder-only: never
  /// read by the public viewer.
  colorPresets Json?

  /// Viewer page-dot indicator. Null falls back to the accent / a translucent
  /// white — see DEFAULT_DOT_COLORS in showcase-theme.ts.
  dotsEnabled      Boolean @default(true)
  dotColorActive   String?
  dotColorInactive String?

  /// Raw CSS appended inside the viewer only. Admin-authored (same trust level
  /// as the rest of the builder) — never rendered anywhere client-facing input
  /// reaches.
  customCss String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pages  ShowcasePage[]
  tracks ShowcaseTrack[]
}

/// One slide. The block tree is a single JSON blob (see ShowcasePage.blocksJson
/// doc below) but the slide's own appearance — background, border — is real
/// columns: unlike a block tree there is exactly one of each per page, so
/// there is nothing to gain from JSON here (see AGENTS.md: model growth as
/// columns/relations, not denormalised JSON).
model ShowcasePage {
  id         String   @id @default(cuid())
  showcaseId String
  showcase   Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)

  sortOrder Int @default(0)

  /// Block[] — see lib/showcase-blocks.ts for the shape. Coordinates are
  /// percentages of the page frame, canvas-absolute even for grouped blocks.
  blocksJson Json

  /// Slide background — same BlockBg union as a block's `bg` (see
  /// showcase-blocks.ts), stored as a plain string for the same reason a
  /// block's is: new values shouldn't need a migration.
  bg              String  @default("none")
  bgCustom        String?
  bgCustomAlpha   Int?
  bgGradientFrom  String?
  bgGradientTo    String?
  bgGradientAngle Int?

  borderStyle String  @default("none")
  borderWidth Int     @default(0)
  borderColor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([showcaseId])
}

/// A background-music track. Files live on disk under
/// uploads/[projectId]/audio/[filename], the same split of generated disk name
/// vs. uploaded name as Photo.
model ShowcaseTrack {
  id         String   @id @default(cuid())
  showcaseId String
  showcase   Showcase @relation(fields: [showcaseId], references: [id], onDelete: Cascade)

  filename     String
  originalName String
  size         Int
  sortOrder    Int    @default(0)

  createdAt DateTime @default(now())

  @@index([showcaseId])
}

model ProjectAssignment {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Photo {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Generated UUID used on disk — keeps the filesystem free of traversal and
  /// encoding hazards.
  filename String

  /// The name the photographer uploaded. Used for downloads and ZIP entries.
  originalName String

  width     Int
  height    Int
  size      Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  feedback PhotoFeedback[]

  @@unique([projectId, originalName])
}

/// One row per (photo, visitor) action. There are no gallery-visitor accounts —
/// visitorId is a random id the browser generates once and keeps in
/// localStorage, reused across every project it visits. A photo accumulates
/// many independent rows, not one verdict; admin sees these as aggregated
/// counts plus the raw comment text. Never treat visitorId as PII.
model PhotoFeedback {
  id      String @id @default(cuid())
  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)

  visitorId String
  type      FeedbackType

  /// Only present when type == COMMENT. @db.Text because Prisma's default
  /// String maps to VARCHAR(191) on MySQL, too short for free text.
  comment String? @db.Text

  createdAt DateTime @default(now())

  /// The server-side half of "first choice is final": a second POST for the
  /// same (photo, visitor) is rejected with 409, regardless of what the
  /// client's own localStorage claims.
  @@unique([photoId, visitorId])
}
