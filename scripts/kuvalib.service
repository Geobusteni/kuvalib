#
# systemd unit for the Kuvalib production server.
#
# Do not edit this file in place on the server — install-service.sh fills in the
# user and paths and writes the result to /etc/systemd/system/kuvalib.service.
# Re-run install-service.sh after moving the app or changing the Node path.

[Unit]
Description=Kuvalib Photography Delivery Application
Documentation=https://github.com/Geobusteni/kuvalib
After=network-online.target mariadb.service mysql.service
Wants=network-online.target
# Disables the "start-limit hit, giving up" state — belongs in [Unit], not
# [Service] (systemd silently ignores it there). Paired with Restart=always
# below so the service is never left dead by a burst of fast restarts.
StartLimitIntervalSec=0

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__

# server.js (Next standalone) does not read .env itself — systemd loads it here.
# PORT (default 3000) is whatever .env sets; keep it in sync with nginx's
# proxy_pass and with the health check in update-from-github.sh.
EnvironmentFile=__APP_DIR__/.env
Environment=NODE_ENV=production
# Bind to loopback only; nginx terminates TLS and proxies in. This overrides any
# HOSTNAME in .env on purpose — the app must not be world-reachable directly.
Environment=HOSTNAME=127.0.0.1

ExecStart=__NODE_BIN__ server.js

# Restart on *any* exit — crash, OOM kill, unhandled rejection, manual kill,
# `systemctl kill`.
Restart=always
RestartSec=3

# update-from-github.sh sends SIGTERM and waits for a clean exit before swapping
# in the new build. Give in-flight downloads/uploads time to finish.
TimeoutStopSec=30
KillSignal=SIGTERM

# Light hardening — the app only needs its own directory and the uploads path.
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
